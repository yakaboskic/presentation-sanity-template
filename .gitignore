node_modules/
dist/
site/
.slidev/
*-export/
exports/
*.local
__pycache__/
*.pyc
.venv/

# Caches and generated config — presentation-sanity writes each blog's
# VitePress config to .cache/vitepress/<presentation>/ on every build.
.cache/

# Slidev writes a temporary index.html next to the deck while it builds.
presentations/**/index.html

# Rendered manim videos (public/manim/) are committed on purpose: deploys,
# including the GitHub Pages workflow, ship them as they are instead of
# re-rendering, so a runner never needs cairo, pango, ffmpeg or LaTeX.
